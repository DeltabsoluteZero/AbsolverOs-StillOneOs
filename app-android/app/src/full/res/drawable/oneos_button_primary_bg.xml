<?xml version="1.0" encoding="utf-8"?>
<!-- AbsolverOS 24K Metallic Gold Gradient Pill Button -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/oneos_ripple_on_primary">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FFE082"
                android:centerColor="#D4AF37"
                android:endColor="#9E7318"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#80FFF2C2" />
            <corners android:radius="@dimen/oneos_button_radius" />
        </shape>
    </item>
</ripple>
